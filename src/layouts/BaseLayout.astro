---
import "../styles/global.css";
const { title, link: { title: linkTitle, href } } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center justify-between p-4">
        <ul class="flex list-none p-0 gap-4">
          <li>
            <h1 class="text-xl font-semibold">{title}</h1>
          </li>
        </ul>
        <ul class="flex list-none p-0 gap-4">
          <li>
            <a href={href} class="text-blue-600 hover:underline">{linkTitle}</a>
          </li>
        </ul>
      </nav>
    </header>
    <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
      <section>
        <slot />
      </section>
    </main>
    <footer class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 border-t border-gray-200 py-6"></footer>
  </body>
</html>
